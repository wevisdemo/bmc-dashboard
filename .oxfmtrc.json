{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"svelte": true,
	"sortImports": {
		"newlinesBetween": false,
		"groups": [
			"value-builtin",
			"value-external",
			"lib-alias",
			["value-parent", "value-sibling", "value-index"],
			"unknown"
		],
		"customGroups": [
			{
				"groupName": "lib-alias",
				"elementNamePattern": ["$lib", "$lib/**"]
			}
		]
	},
	"sortTailwindcss": {
		"stylesheet": "./src/routes/layout.css"
	}
}
